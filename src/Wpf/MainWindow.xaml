<Window x:Class="RoadRash.Workbench.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource ui.windowTitle}" Width="1320" Height="880" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F4F5F6" Foreground="{StaticResource Ink}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid x:Name="Surface" Background="#F4F5F6">
    <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="84"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{StaticResource Accent}" Width="38" Height="38" CornerRadius="9" Margin="0,0,12,0"><TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="{DynamicResource ui.brand}" FontWeight="Bold" FontSize="19"/><TextBlock Text="{DynamicResource ui.subtitle}" Style="{StaticResource Caption}"/></StackPanel></StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="24,0,16,0" MaxWidth="460"><TextBlock Text="{DynamicResource ui.gameDirectory}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding GameDirectory}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameDirectory}"/></StackPanel>
        <Button Grid.Column="2" Content="{DynamicResource ui.chooseDirectory}" Click="ChooseDirectory" VerticalAlignment="Center" IsEnabled="{Binding Editable}"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="20,24,24,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="182"/><ColumnDefinition Width="*"/><ColumnDefinition Width="228"/></Grid.ColumnDefinitions>
      <DockPanel Margin="0,0,20,0">
        <StackPanel DockPanel.Dock="Bottom" Margin="12,14,0,22"><TextBlock Text="{DynamicResource ui.sidebarCaption}" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock Text="{DynamicResource ui.sidebarBrand}" FontSize="9" Foreground="#9AA1A8" Margin="0,7,0,0"/></StackPanel>
        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding Page}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="12,13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FBE8DF"/><Setter Property="Foreground" Value="#B64C22"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="#D5D9DD"/><Setter TargetName="Bg" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="27" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/><TextBlock Text="{Binding Title}" FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,20" IsEnabled="{Binding Editable}">
        <StackPanel>
          <TextBlock Text="{Binding Page.Number, StringFormat='设置 / {0}'}" FontSize="11" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Page.Title}" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,7"/>
          <TextBlock Text="{Binding Page.Caption}" Style="{StaticResource Caption}" Margin="0,0,0,24"/>
          <Border Style="{StaticResource Card}" Visibility="{Binding IsRace, Converter={StaticResource BoolVisibility}}">
            <StackPanel><TextBlock Text="{DynamicResource ui.presets.title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ui.presets.description}" Style="{StaticResource Caption}" Margin="0,5,0,16"/>
              <UniformGrid Columns="5"><Button Style="{StaticResource ModeButton}" Command="{Binding ModeCommand}" CommandParameter="normal" Margin="0,0,8,0" Padding="4,17"><StackPanel><TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource ui.presets.normal}" FontWeight="Medium" Margin="0,10,0,0"/></StackPanel></Button><Button Style="{StaticResource ModeButton}" Command="{Binding ModeCommand}" CommandParameter="car" Margin="0,0,8,0" Padding="4,17"><StackPanel><TextBlock Text="&#xE804;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource ui.presets.car}" FontWeight="Medium" Margin="0,10,0,0"/></StackPanel></Button><Button Style="{StaticResource ModeButton}" Command="{Binding ModeCommand}" CommandParameter="truck" Margin="0,0,8,0" Padding="4,17"><StackPanel><Path Data="M 1,4 H 15 V 17 H 1 Z M 15,9 H 20 L 24,13 V 17 H 15 M 8,18 A 3,3 0 1 1 2,18 A 3,3 0 1 1 8,18 M 22,18 A 3,3 0 1 1 16,18 A 3,3 0 1 1 22,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource ui.presets.truck}" FontWeight="Medium" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource ModeButton}" Command="{Binding ModeCommand}" CommandParameter="run" Padding="4,17"><StackPanel><TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource ui.presets.run}" FontWeight="Medium" Margin="0,10,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource ModeButton}" Command="{Binding ModeCommand}" CommandParameter="police" Margin="8,0,0,0" Padding="4,17" ToolTip="{DynamicResource ui.presets.policeDescription}"><StackPanel><TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource ui.presets.police}" FontWeight="Medium" Margin="0,10,0,0"/></StackPanel></Button>
              </UniformGrid><TextBlock Text="{Binding PresetNote}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
              <DockPanel DataContext="{Binding Settings[hardcore]}" Margin="0,16,0,0">
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                          IsEnabled="{Binding Enabled}" IsChecked="{Binding BoolValue, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}"/>
                <StackPanel Margin="0,0,16,0">
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                </StackPanel>
              </DockPanel>
              <DockPanel Margin="0,16,0,0">
                <CheckBox x:Name="PublicEnemySwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                          IsEnabled="{Binding Settings[policeOpponents].Enabled}" IsChecked="{Binding PublicEnemyPreset, Mode=TwoWay}" VerticalAlignment="Center"
                          AutomationProperties.Name="{DynamicResource ui.presets.publicEnemy}" />
                <StackPanel Margin="0,0,16,0">
                  <TextBlock Text="{DynamicResource ui.presets.publicEnemy}" FontWeight="SemiBold"/>
                  <TextBlock Text="{DynamicResource ui.presets.publicEnemyDescription}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                </StackPanel>
              </DockPanel>
              <WrapPanel Margin="0,18,0,-8"><Button Style="{StaticResource Chip}" Content="{DynamicResource ui.scale.4}" Command="{Binding ScaleCommand}" CommandParameter="4"/><Button Style="{StaticResource Chip}" Content="{DynamicResource ui.scale.15}" Command="{Binding ScaleCommand}" CommandParameter="15"/><Button Style="{StaticResource Chip}" Content="{DynamicResource ui.scale.100}" Command="{Binding ScaleCommand}" CommandParameter="100"/><Button Style="{StaticResource Chip}" Content="{DynamicResource ui.scale.500}" Command="{Binding ScaleCommand}" CommandParameter="500"/><Button Style="{StaticResource Chip}" Content="{DynamicResource ui.scale.10000}" Command="{Binding ScaleCommand}" CommandParameter="10000"/></WrapPanel>
            </StackPanel>
          </Border>
          <WrapPanel Visibility="{Binding IsTraffic, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"><Button Style="{StaticResource Chip}" Content="{DynamicResource ui.traffic.quiet}" Command="{Binding TrafficCommand}" CommandParameter="0,0"/><Button Style="{StaticResource Chip}" Content="{DynamicResource ui.traffic.normal}" Command="{Binding TrafficCommand}" CommandParameter="1,1"/><Button Style="{StaticResource Chip}" Content="{DynamicResource ui.traffic.busy}" Command="{Binding TrafficCommand}" CommandParameter="4,2"/><Button Style="{StaticResource Chip}" Content="{DynamicResource ui.traffic.dense}" Command="{Binding TrafficCommand}" CommandParameter="10,4"/></WrapPanel>
          <WrapPanel Visibility="{Binding IsDisplay, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"><Button Style="{StaticResource Chip}" Content="{DynamicResource ui.display.classic}" Command="{Binding DisplayCommand}" CommandParameter="classic"/><Button Style="{StaticResource Chip}" Content="{DynamicResource ui.display.hd}" Command="{Binding DisplayCommand}" CommandParameter="hd"/><Button Style="{StaticResource Chip}" Content="{DynamicResource ui.display.smooth}" Command="{Binding DisplayCommand}" CommandParameter="smooth"/></WrapPanel>
          <Border Style="{StaticResource Card}" Visibility="{Binding IsTools, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="{DynamicResource ui.tools.title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ui.tools.description}" Style="{StaticResource Caption}" Margin="0,6,0,16"/><WrapPanel><Button Content="{DynamicResource ui.tools.openDirectory}" Click="OpenDirectory" Margin="0,0,8,8"/><Button Content="{DynamicResource ui.tools.log}" Command="{Binding ToggleLogCommand}" Margin="0,0,8,8"/><Button Content="{DynamicResource ui.tools.help}" Click="OpenReadme" Margin="0,0,8,8"/><Button Content="{DynamicResource ui.tools.startOnly}" Command="{Binding StartOnlyCommand}" ToolTip="{DynamicResource ui.tools.startOnlyTip}" Margin="0,0,8,8"/><Button Content="{DynamicResource ui.tools.restore}" Click="RestoreOriginal" Margin="0,0,8,8"/></WrapPanel><TextBlock Text="{DynamicResource ui.tools.restoreDescription}" Style="{StaticResource Caption}"/></StackPanel></Border>
          <ItemsControl ItemsSource="{Binding Page.Groups}"/>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,0,20">
        <StackPanel>
          <Border Background="#27333D" CornerRadius="12" Padding="22,23"><StackPanel><TextBlock Text="{DynamicResource ui.summary.title}" FontSize="11" Foreground="#B3C0CA"/><DockPanel Margin="0,16,0,12"><Border DockPanel.Dock="Right" Background="#45504E" CornerRadius="5" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="{Binding Mode}" FontSize="11" Foreground="#E8C09A"/></Border><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SummaryCount}" FontSize="38" FontWeight="Light" Foreground="White"/><TextBlock Text="{DynamicResource ui.summary.people}" Foreground="#B3C0CA" Margin="7,0,0,8" VerticalAlignment="Bottom"/></StackPanel></DockPanel><Border Height="1" Background="#45515B" Margin="0,0,0,17"/><TextBlock Text="{Binding SummaryDisplay}" FontSize="12" Foreground="#E0E5E9"/><TextBlock Text="{Binding SummaryTraffic}" FontSize="12" Foreground="#E0E5E9" Margin="0,10,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="18,20" Margin="0,14,0,0"><StackPanel><TextBlock Text="{DynamicResource ui.summary.rules}" FontWeight="SemiBold"/><TextBlock Text="{Binding ModeNote}" Style="{StaticResource Caption}" Margin="0,12,0,0"/><TextBlock Text="{DynamicResource ui.summary.runSpeed}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,18,0,7"/><TextBlock Text="{Binding SummarySpeed}" FontSize="12"/><TextBlock Text="{Binding SummaryFeatures}" Style="{StaticResource Caption}" Margin="0,15,0,0" LineHeight="26"/><Border Height="1" Background="{StaticResource Line}" Margin="0,16"/><TextBlock Text="{Binding SummaryFix}" FontSize="12" Foreground="#5F7865"/></StackPanel></Border>
          <TextBlock Text="{DynamicResource ui.draftHint}" Style="{StaticResource Caption}" Margin="8,16,8,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Visibility="{Binding LogVisible, Converter={StaticResource BoolVisibility}}" Background="#E9ECEF" Padding="24,12"><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource ui.collapseLog}" Style="{StaticResource Quiet}" Command="{Binding ToggleLogCommand}" VerticalAlignment="Top"/><TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="146" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" VerticalScrollBarVisibility="Auto" Background="#F7F8F9" TextWrapping="Wrap"/></DockPanel></Border>
    <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Button Content="{DynamicResource ui.reset}" Command="{Binding ResetCommand}" Style="{StaticResource Quiet}"/><Button Content="{DynamicResource ui.undo}" Command="{Binding UndoCommand}" Visibility="{Binding CanUndo, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Quiet}" Foreground="{StaticResource Accent}"/></StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="20,0" MaxHeight="42"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="{DynamicResource ui.log}" Command="{Binding ToggleLogCommand}" Style="{StaticResource Quiet}" Margin="0,0,8,0"/><Button Content="{DynamicResource ui.apply}" Command="{Binding ApplyCommand}" Margin="0,0,12,0"/><Button Content="{DynamicResource ui.launch}" Command="{Binding LaunchCommand}" Style="{StaticResource Primary}" Padding="22,10"/></StackPanel>
    </Grid></Border>
  </Grid>
</Window>
